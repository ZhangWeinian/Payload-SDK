{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "displayName": "cy_raspberry_pi 公共基座",
            "description": "与顶层 CMakePresets.json 的 base 预设对齐",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../../../../../cmake/aarch64-linux-gnu.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON",
                "CMAKE_C_STANDARD": "23",
                "CMAKE_C_STANDARD_REQUIRED": "ON",
                "CMAKE_C_EXTENSIONS": "OFF",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF"
            }
        },
        {
            "name": "aarch64",
            "displayName": "Release (aarch64-linux / RK3588S)",
            "description": "始终产出 aarch64 的 Release",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/aarch64-linux/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "aarch64",
            "displayName": "Build AArch64 (RK3588S)",
            "description": "并行度取核数",
            "configurePreset": "aarch64",
            "jobs": 8
        }
    ]
}
