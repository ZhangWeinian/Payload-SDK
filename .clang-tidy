---
# ============================================================================
# cy_psdk clang-tidy 配置 (C++23 / LLVM 23)
#
# 使用方式:
#   bash/samples/sample_c++/platform/linux/cy_psdk/../../../../bash/clang-tidy.sh ...
#   或直接: 见 samples/sample_c++/platform/linux/cy_psdk/../ 说明 / doc/build-dual-toolchain.md
#
# 设计原则:
#   1. 只针对自有代码 (cy_psdk/src, cy_psdk/test) 检查; DJI 官方样例与 vcpkg 依赖
#      由脚本在编译数据库层面过滤, 不进入分析范围。
#   2. 关闭与项目既定风格冲突的检查 (宏命名风格 / 传统返回类型 / 魔法数字),
#      保留真正能发现缺陷的检查族: bugprone-* / clang-analyzer-* / concurrency-*。
#      注意 optin 子族（全族开启, 不做任何排除）: 它属于 LLVM 文档 1.1.5
#      「Default Checkers」而不是实验族 —— 实验族是 alpha.*(文档明言 "may crash or
#      emit a higher number of false positives"), clang-tidy 根本不暴露。optin 默认关
#      只因它们带「项目策略」色彩, 由项目自行决定采纳。它含 optin.cplusplus.VirtualCall
#      / optin.core.EnumCastOutOfRange / optin.portability.UnixAPI /
#      optin.performance.Padding 等有明确规则依据的检查。
#      排除项必须写成纯检查名 —— Checks 是 YAML 折叠块标量, 块内 # 不是注释而是字面
#      文本, 会让该条静默失效。
#   3. 不以警告即错误运行, 便于渐进式治理。
# ============================================================================
Checks: >
    -*,
    bugprone-*,
    clang-analyzer-*,
    concurrency-*,
    performance-*,
    portability-*,
    modernize-*,
    misc-*,
    -bugprone-easily-swappable-parameters,
    -bugprone-exception-escape,
    -bugprone-unchecked-optional-access,
    -modernize-use-trailing-return-type,
    -modernize-use-auto,
    -modernize-avoid-c-arrays,
    -misc-non-private-member-variables-in-classes,
    -misc-include-cleaner,
    -misc-no-recursion,
    -misc-use-anonymous-namespace,
    -portability-avoid-pragma-once

WarningsAsErrors: ""

# 仅对自有头文件报告 (避免第三方/DJI 头文件噪音)
HeaderFilterRegex: '.*cy_psdk/(src|test)/.*\.h(pp)?$'

FormatStyle: file

CheckOptions:
    # 并发: 与项目大量使用 std::mutex/atomic 的现实匹配
    - key: concurrency-mt-unsafe.FunctionSet
      value: "posix"

    # bugprone: 精调, 降低误报
    - key: bugprone-argument-comment.StrictMode
      value: "0"
    - key: bugprone-suspicious-stringview-data-usage.StringViewTypes
      value: "::std::basic_string_view;::std::string_view"
    - key: bugprone-narrowing-conversions.PedanticMode
      value: "0"
    - key: bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
      value: "1"

    # bugprone-reserved-identifier: 白名单已清空 (LLVM 风格迁移后无任何保留名需求);
    # 如需新增: AllowedIdentifiers 官方定义为正则列表且为非锚定匹配, 条目务必用 ^...$ 锚定防误伤

    # performance: 保留有价值的项
    - key: performance-move-const-arg.CheckTriviallyCopyableMove
      value: "1"

    # modernize: 与 C++23 目标对齐
    - key: modernize-use-nullptr.NullMacros
      value: "NULL"
    - key: modernize-use-override.IgnoreDestructors
      value: "0"
...
