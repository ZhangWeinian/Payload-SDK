# 构建产物目录
build/

# install 目标输出 (预设 installDir 指向 ${sourceDir}/install/<preset>)
/install/

# vcpkg manifest 模式: 源码根下 CLI 安装目录 / 各构建树内安装目录
vcpkg_installed/

# codegraph 相关
.codegraph/

# 其他编译产物
*.o
*.a
*.so
*.la

# system_lib/ 下的运行库需要随版本入库分发, 排除在 *.so 忽略之外
!system_lib/**/*.so

# 日志文件
*.log

# 临时文件
*~
*.swp
.DS_Store

# 和平台/环境相关的，不具备移植性的文件/文件夹
rsync.sh
