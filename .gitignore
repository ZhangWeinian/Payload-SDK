# 构建产物目录
build/

# install 目标输出 (预设 installDir 指向 ${sourceDir}/install/<preset>)
/install/

# vcpkg manifest 模式: 源码根下 CLI 安装目录 / 各构建树内安装目录
vcpkg_installed/

# VS Code 配置
# .vscode/
.codegraph/

# 其他编译产物
*.o
*.a
*.so
*.la

# system_libs/ 下的运行库需要随版本入库分发, 排除在 *.so 忽略之外
!system_libs/**/*.so

# 日志文件
*.log

# 临时文件
*~
*.swp
.DS_Store

artifacts/
